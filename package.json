{
  "name": "@teelur/budget-board-ui",
  "version": "0.2.0",
  "packageManager": "yarn@4.18.0",
  "description": "UI components for the Budget Board app built on Mantine headless primitives",
  "main": "./dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite",
    "docs:dev": "vite --config docs.vite.config.ts",
    "docs:build": "tsc -p tsconfig.docs.json && vite build --config docs.vite.config.ts",
    "docs:preview": "vite preview --config docs.vite.config.ts",
    "prepare": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/teelur/budget-board-ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  },
  "peerDependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "dayjs": "^1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dayjs": "^1.11.23",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
